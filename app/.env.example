# คัดลอกเป็น app/.env แล้วใส่ค่าจริง (app/.env ไม่ขึ้น git)
# LINE Developers Console > Messaging API channel
#   Basic settings   > Channel secret
#   Messaging API    > Channel access token (long-lived) > Issue
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# (ไม่บังคับ) เปลี่ยนโมเดล / ที่เก็บฐานข้อมูล
# CHAT_MODEL=scb10x/llama3.1-typhoon2-8b-instruct
# FALLBACK_MODEL=scb10x/llama3.2-typhoon2-3b-instruct
# APP_DB=data/app/psu_dealing.db

# log ใน terminal ที่รัน uvicorn
# LOG_LEVEL=INFO        (DEBUG = ละเอียดขึ้น)
# LOG_TEXT=1            (0 = ไม่แสดงข้อความที่ผู้ใช้พิมพ์ในหน้าจอ)
