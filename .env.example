# Copy to .env in the repository root. Never commit .env or real keys.
API_BASE_URL=https://ai.psu.blue/v1
API_KEY_1=
API_KEY_2=
API_KEY_3=

# With any API key configured, explain_match uses the PSU API model below
# and falls back to the existing local Typhoon2 8B model on API failure.
LLM_EXPLAIN_MATCH=api:openai/gpt-5.6-luna

# Optional: keep RAG local (default), or enable API for this task too.
# LLM_RAG_ANSWER=api:PSU-LLM/psu-gemma

# Local Ollama endpoint for extraction, RAG, and API fallback.
OLLAMA_URL=http://localhost:11434
